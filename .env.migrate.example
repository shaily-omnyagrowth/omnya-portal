# .env.migrate: settings for `npm run db:migrate` (spec 0001).
# Copy to .env.migrate and fill in. .env.migrate is gitignored and must stay on
# the machine of whoever runs migrations. Never put these in Vercel or GitHub.

# Session pooler connection string, port 5432 (NOT 6543, the transaction pooler).
# Supabase -> Project Settings -> Database -> Connection string -> Session pooler.
# Percent-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Must match the ref inside SUPABASE_DB_URL. Production is aglikzyarmqbdmjvkvyj.
SUPABASE_PROJECT_REF=<project-ref>

# Where backups and migrate.log go. Must be outside this repo and outside OneDrive
# (the dumps hold creator emails and the payout ledger). Default: ~/omnya-backups
# MIGRATE_BACKUP_DIR=C:\omnya-backups
